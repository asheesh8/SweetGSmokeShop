# Reserve / hold form delivery.
# Without all three set, /api/reserve returns an honest 503 and the form tells
# the customer to call the shop instead — it never fakes a successful send.

# https://resend.com — free tier is plenty for a shop this size.
RESEND_API_KEY=

# Must be a domain verified in Resend, e.g. holds@sweetgsmokeshop.com
RESEND_FROM=

# Where hold requests land.
SHOP_INBOX=
