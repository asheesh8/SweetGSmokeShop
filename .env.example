# ── Supabase — inventory database + /admin ──────────────────────────────────
# Without these the site runs on its built-in catalogue and /admin shows setup
# instructions instead of a login. Nothing breaks; it just isn't editable yet.
#
# Copy from your Supabase project: Project Settings → API.
# Both are publishable keys and are safe in the browser — Row Level Security
# (created by supabase/schema.sql) is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Reserve / hold form delivery ────────────────────────────────────────────
# Without all three, /api/reserve returns an honest 503 and the form tells the
# customer to call the shop. It never fakes a successful send.

# https://resend.com — free tier is plenty for a shop this size.
RESEND_API_KEY=

# Must be a domain verified in Resend, e.g. holds@sweetgsmokeshop.com
RESEND_FROM=

# Where hold requests land.
SHOP_INBOX=
